# Market Stress Copilot — environment template
# Usage:
#   cp .env.example .env
#   then edit .env and fill in your real OPENAI_API_KEY.
# DO NOT commit .env. Only this template (.env.example) is tracked.

# ---------- OpenAI ----------
# Required for non-degraded operation. Without it, the app runs in
# deterministic fallback mode and shows a banner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Quality / agentic loop ----------
QUALITY_THRESHOLD=0.75
MAX_LOOP_ITERATIONS=2

# ---------- LLM gateway ----------
LLM_MAX_RETRIES=3
LLM_CACHE_TTL_MIN=30
LLM_TIMEOUT_SECONDS=30

# ---------- Webhook ----------
# Change this in production. If left blank, the webhook accepts any payload
# (fine for local demos, NOT for a public deployment).
TV_WEBHOOK_SECRET=change-me

# ---------- Ports (docker-compose only) ----------
HOST_PORT=3838
WEBHOOK_PORT=8000

# ---------- Storage ----------
APPV2_DB_PATH=data/alerts.sqlite
